<?xml version="1.0" ?>
<robot name="tiago_pro" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find tiago_pro_moveit_config)/config/srdf/disable_collisions/tiago_pro_no-arm-right.srdf.xacro" />
  <xacro:include filename="$(find tiago_pro_moveit_config)/config/srdf/disable_collisions/left_custom.srdf.xacro" />
    <disable_collisions link1="arm_left_1_link" link2="arm_left_7_link" reason="Never"/>
    <disable_collisions link1="arm_left_1_link" link2="arm_left_tool_link" reason="Never"/>
</robot>
